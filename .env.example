# ─── SQL Server (Docker Compose — desarrollo local) ──────────────────────────
# Contraseña para el usuario 'sa'. Requisitos de SQL Server:
# mínimo 8 caracteres, mayúscula, minúscula, número y símbolo.
SA_PASSWORD=Dev@Password_2024!

# ─── Backend ASP.NET Core ────────────────────────────────────────────────────

# JWT — OBLIGATORIO en producción (mínimo 32 caracteres)
# Generar con: openssl rand -base64 48
JwtSettings__SecretKey=REEMPLAZA_CON_CLAVE_SEGURA_DE_AL_MENOS_32_CARACTERES

# Connection string — producción (SQL Server con autenticación SQL, no Windows auth)
# Ejemplo para Railway/Render con SQL Server en contenedor:
# ConnectionStrings__DefaultConnection=Server=<host>,<port>;Database=SistemaEvaluacion;User Id=sa;Password=<password>;TrustServerCertificate=True;
#
# Ejemplo para Azure SQL Database:
# ConnectionStrings__DefaultConnection=Server=tcp:<server>.database.windows.net,1433;Database=SistemaEvaluacion;User Id=<user>;Password=<password>;Encrypt=True;

# Puerto de escucha — Railway/Render inyectan PORT automáticamente
# Establecer ASPNETCORE_URLS=http://+:$PORT en el dashboard (Railway) o en Render vars
# El Dockerfile usa 8080 por defecto; ajustar si el proveedor requiere otro puerto.
# ASPNETCORE_URLS=http://+:8080

# CORS — orígenes permitidos en producción (separados por índice si son varios)
# Cors__AllowedOrigins__0=https://tu-app.vercel.app
# Cors__AllowedOrigins__1=https://tu-dominio.com

# Rate limiting — intentos de login por minuto (default: 5)
# RateLimit__LoginPermitLimit=5

# ─── Frontend Next.js ────────────────────────────────────────────────────────
# Crear sistema-evaluacion-academica/.env.local para desarrollo:
#   NEXT_PUBLIC_API_URL=http://localhost:5000
#
# En Vercel: configurar como variable de entorno en el dashboard
#   NEXT_PUBLIC_API_URL=https://tu-backend.railway.app
